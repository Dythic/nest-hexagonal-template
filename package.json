{
  "name": "nest-hexagonal-template",
  "version": "0.1.0",
  "description": "NestJS + Fastify service template following a hexagonal, functional DDD architecture.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "npm run build && concurrently -k -n tsc,alias,app -c blue,magenta,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tsc-alias -p tsconfig.build.json --watch\" \"node --watch --enable-source-maps dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emulators": "docker compose up -d",
    "create:project": "node scripts/create-project.mjs",
    "generate:feature": "node scripts/generate-feature.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@google-cloud/pubsub": "^5.2.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "fastify": "^5.6.0",
    "firebase-admin": "^13.5.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.0.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
